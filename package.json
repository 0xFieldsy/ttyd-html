{
  "private": true,
  "name": "ttyd-html",
  "version": "0.1.0",
  "description": "Single-file index.html frontend for ttyd",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "check": "tsc -p .",
    "test": "vitest run --no-coverage",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:header": "node scripts/html-header.mjs",
    "preview": "ttyd -W -I dist/index.html bash",
    "lint": "biome ci .",
    "lint:fix": "biome check --fix .",
    "clean": "rimraf dist node_modules/.vite node_modules/.vite-temp",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/vite-react": "8.1.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "rimraf": "6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
